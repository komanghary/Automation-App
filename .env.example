# ── Instagram ─────────────────────────────────────────────────────────────────
IG_USERNAME=your_ig_email
IG_PASSWORD=your_ig_password

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token

# Watcher channel: tempat video IG di-upload otomatis
WATCHER_CHANNEL_ID=123456789

# Watermark channel: tempat proses watermark (preview + confirm)
WATERMARK_CHANNEL_ID=123456789

# ── Watermark ─────────────────────────────────────────────────────────────────
WATERMARK_PATH=watermark.png
WATERMARK_USERNAME=@yourusername

# ── YouTube ───────────────────────────────────────────────────────────────────
# Download client_secret.json dari Google Cloud Console
YT_CLIENT_SECRET=client_secret.json
YT_CATEGORY_ID=22

# ── Gemini ────────────────────────────────────────────────────────────────────
# API Key dari Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key

# ── Watcher ───────────────────────────────────────────────────────────────────
POLL_INTERVAL=30
